# Copy to config.env and adjust. All scripts source this file.
export AWS_REGION="us-east-1"
export CLUSTER_NAME="karpenter-upgrade-poc"

# Version being upgraded FROM (must match terraform cluster_version)
export CURRENT_VERSION="1.32"
# Version being upgraded TO (the exercise)
export TARGET_VERSION="1.33"

# Karpenter chart version. Before the hop, confirm it supports TARGET_VERSION:
# https://karpenter.sh/docs/upgrading/compatibility/
export KARPENTER_VERSION="1.8.1"
