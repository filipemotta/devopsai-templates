{
  "$schema": "https://claude.ai/schemas/settings.json",
  "permissions": {
    "allow": [
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform show:*)",
      "Bash(terraform validate:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(aws sts get-caller-identity)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__kubernetes__get_pods",
      "mcp__kubernetes__get_logs",
      "mcp__kubernetes__describe_*",
      "mcp__terraform__plan",
      "mcp__terraform__show"
    ],
    "deny": [
      "Bash(kubectl delete:*)",
      "Bash(kubectl exec:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(rm -rf:*)",
      "Bash(aws * delete*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)"
    ]
  },
  "model": {
    "default": "claude-opus-4-7",
    "allowSwitch": true
  },
  "context": {
    "maxTokens": 100000,
    "autoCompact": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Evaluate safety: block terraform destroy without -target, kubectl delete namespace in prod, rm -rf on critical paths, git push --force to main. Approve if safe.",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$CLAUDE_TOOL_FILE_PATH\"; if [[ \"$FILE\" == *.tf ]]; then terraform fmt \"$FILE\" 2>/dev/null && echo '✅ Terraform formatted'; elif [[ \"$FILE\" == *.yaml || \"$FILE\" == *.yml ]]; then yamllint -d relaxed \"$FILE\" 2>/dev/null && echo '✅ YAML valid'; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before stopping, verify: 1) terraform validate passed? 2) K8s manifests valid? 3) No secrets exposed? 4) All tasks completed?",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
